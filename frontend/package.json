{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"*.{js,ts}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,vue,css,md}\" \"*.{js,ts}\" \"../*.md\" \"../docs/**/*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,vue,css,md}\" \"*.{js,ts}\" \"../*.md\" \"../docs/**/*.md\"",
    "docs:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "fix": "npm run lint:fix && npm run format:fix",
    "check": "npm run lint && npm run format && npm run docs:lint && npm run build"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.3",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.11",
    "eslint-plugin-vue": "^10.9.2",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vue-tsc": "^3.3.6"
  }
}
