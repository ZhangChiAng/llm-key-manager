{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,vue,css,md}\" \"../*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,vue,css,md}\" \"../*.md\"",
    "docs:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "preview": "vite preview"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@babel/types": "^7.18.10",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.10",
    "eslint-plugin-vue": "^10.9.2",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  },
  "allowScripts": {
    "esbuild@0.15.18": true
  }
}
