{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"*.{js,ts}\" --fix",
    "format": "prettier --check \"src/**/*.{ts,vue,css,md}\" \"*.{js,ts}\" \"../*.md\" \"../docs/**/*.md\"",
    "format:fix": "prettier --write \"src/**/*.{ts,vue,css,md}\" \"*.{js,ts}\" \"../*.md\" \"../docs/**/*.md\"",
    "docs:lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc",
    "fix": "npm run lint:fix && npm run format:fix",
    "check": "npm run lint && npm run format && npm run docs:lint && npm run build"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.11",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-jsdoc": "^65.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vue-tsc": "^3.3.14"
  }
}
